# Copy this file to .env and fill in your API keys
# Then run: python scripts/fetch_earnings_calendar.py

# Financial Modeling Prep — https://financialmodelingprep.com/developer
# Free tier: 250 API calls/day
FMP_API_KEY=your_fmp_key_here

# Finnhub — https://finnhub.io/dashboard
# Free tier: 60 API calls/minute
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage — https://alphavantage.co/support/#api-key
# Free tier: 25 requests/day
ALPHAVANTAGE_KEY=your_alphavantage_key_here

# SEC EDGAR — https://www.sec.gov/developer
# No key required. Use your email as User-Agent per SEC guidelines.
SEC_USER_AGENT=YourAppName your@email.com
