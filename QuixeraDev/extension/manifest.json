{
  "action": {
    "default_popup": "popup.html",
    "default_title": "QA Capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Flag bugs on any site you test. Annotate screenshots, record clips, and file with click trail to the QA dashboard you choose.",
  "host_permissions": [
    "<all_urls>",
    "https://api.github.com/*"
  ],
  "icons": {
    "128": "icon128.png",
    "48": "icon48.png"
  },
  "manifest_version": 3,
  "name": "QA Capture",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "version": "3.7.0"
}