{
  "id": "general_business",
  "name": "General Business",
  "version": "1.0.0",
  "vocabulary": [
    "KPI",
    "OKR",
    "ROI",
    "stakeholder",
    "roadmap",
    "onboarding",
    "SLA",
    "ARR",
    "MRR",
    "pipeline",
    "deliverable",
    "quarterly"
  ],
  "abbreviations": {
    "eod": "end of day",
    "asap": "as soon as possible",
    "fyi": "FYI",
    "eta": "ETA",
    "faq": "FAQ",
    "yoy": "YoY"
  },
  "promptFragment": "General business communication. Keep names, figures and dates exactly.",
  "templates": [
    {
      "id": "meeting_notes",
      "name": "Meeting notes",
      "trigger": [
        "meeting notes"
      ],
      "skeleton": "Attendees:\n\nAgenda:\n\nDecisions:\n\nAction items:\n"
    },
    {
      "id": "status_update",
      "name": "Status update",
      "trigger": [
        "status update"
      ],
      "skeleton": "Done:\n\nNext:\n\nBlockers:\n"
    }
  ],
  "detectors": {
    "apps": [
      "outlook",
      "slack",
      "teams",
      "gmail",
      "zoom"
    ],
    "windowTitleKeywords": [
      "inbox",
      "meeting",
      "agenda",
      "proposal"
    ],
    "contentKeywords": [
      "meeting",
      "quarter",
      "budget",
      "deadline",
      "client",
      "invoice"
    ]
  },
  "safety": {
    "cloudAllowed": true
  },
  "description": "Illustrative sample pack for everyday business writing.",
  "rules": [
    {
      "pattern": "\\bq one\\b",
      "replace": "Q1"
    },
    {
      "pattern": "\\bq two\\b",
      "replace": "Q2"
    },
    {
      "pattern": "\\bq three\\b",
      "replace": "Q3"
    },
    {
      "pattern": "\\bq four\\b",
      "replace": "Q4"
    }
  ]
}
