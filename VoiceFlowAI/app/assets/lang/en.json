    "promptRules": [
      {
        "pattern": "(^|[.?!]\\s+)what (?:i|we)(?:'m|'re| am| are) (?:trying|going|looking|hoping) to (?:do|achieve|build|make|get)(?: here)? is(?: trying| going| looking)?(?: to)?\\s+",
        "replace": "$1Goal: "
      },
      {
        "pattern": "(^|[.?!]\\s+)(?:(?:ok|okay|alright|all right|anyway|so|right|now)[,.]?\\s+)+",
        "replace": "$1"
      },
      {
        "pattern": "(^|[.?!]\\s+)(?:the |our |my |your )?(?:main |key |overall |primary )?goal (?:is|here is)(?: to)?\\s+",
        "replace": "$1Goal: "
      },
      {
        "pattern": "^\\s*(?:hi|hello|hey)\\s+(?:claude|chatgpt|gpt|gemini|copilot|assistant|ai|bot|there)\\b[,.!]?\\s*",
        "replace": ""
      },
      {
        "pattern": "(^|[.?!]\\s+)(?:let us|let's|lets)\\s+(?:try|test|see)(?:\\s+(?:this|it|that))?(?:\\s+(?:out|again|now))*\\s*[.?!]\\s*",
        "replace": "$1"
      },
      {
        "pattern": "(^|[.?!]\\s+)(?:testing|test|one two three|can you hear me)[.?!]\\s*",
        "replace": "$1"
      },
      {
        "pattern": "(^|[.?!]\\s+)what (?:i|we) (?:want|need|would like) to (?:achieve|do|get|accomplish)(?: here)? is(?: to)?\\s+",
        "replace": "$1Goal: "
      },
      {
        "pattern": "(^|[.?!]\\s+)(?:i|we) (?:am|are|'m|'re) going to\\s+",
        "replace": "$1"
      },
      {
        "pattern": "(^|[.?!]\\s+)(?:i|we) (?:want|need|would like|plan|have) to\\s+",
        "replace": "$1"
      },
      {
        "pattern": "(?:(?:and|but|also|then|plus)\\s+)?(?:(?:keep (?:it|the answer|the response|your answer|your response|this)|make it|limit (?:it|the answer|the response) to|in)\\s+)?(?:no more than|at most|up to|a maximum of|maximum of|max of|not more than|not exceeding)\\s+(\\d+)\\s+(words|sentences|lines|paragraphs|items|examples|characters|bullets|bullet points|points|steps|names|ideas|options|rows|columns|sections|tips|reasons)(?=\\s*(?:$|[.,;!?])|\\s+(?:and|but|then|also)\\b)",
        "replace": "max $1 $2",
        "directive": true
      },
      {
        "pattern": "(?:(?:and|but|also|then|plus)\\s+)?(?:(?:keep (?:it|the answer|the response|your answer|your response|this)|make it|limit (?:it|the answer|the response) to|in)\\s+)?(?:under|less than|fewer than|below)\\s+(\\d+)\\s+(words|sentences|lines|paragraphs|items|examples|characters|bullets|bullet points|points|steps|names|ideas|options|rows|columns|sections|tips|reasons)(?=\\s*(?:$|[.,;!?])|\\s+(?:and|but|then|also)\\b)",
        "replace": "under $1 $2",
        "directive": true
      },
      {
        "pattern": "(?:no more than|at most|up to|a maximum of|maximum of|max of|not more than|not exceeding)\\s+(\\d+)\\s+(words|sentences|lines|paragraphs|items|examples|characters|bullets|bullet points|points|steps|names|ideas|options|rows|columns|sections|tips|reasons)",
        "replace": "max $1 $2"
      },
      {
        "pattern": "\\b(?:less than|fewer than|below)\\s+(\\d+)\\s+(words|sentences|lines|paragraphs|items|examples|characters|bullets|bullet points|points|steps|names|ideas|options|rows|columns|sections|tips|reasons)",
        "replace": "under $1 $2"
      },
      {
        "pattern": "\\b(\\d+) bullet points?\\b",
        "replace": "$1 bullets"
      },
      {
        "pattern": "\\bbullet points\\b",
        "replace": "bullets"
      },
      {
        "pattern": "(?:(?:and|but|also|then|plus)\\s+)?\\b(?:make it|keep it|keep the answer|keep your answer|keep the response|keep your response|keep this|be) (?:very )?(?:short|brief|concise|succinct)(?: and (?:short|brief|concise|simple|to the point))?(?=\\s*(?:$|[.,;!?]|\\s(?:just|only|and|but|then|also|keep|make|use|write|give|show)\\b))",
        "replace": "be concise",
        "directive": true
      },
      {
        "pattern": "(?:(?:and|but|also|then|plus)\\s+)?\\b(?:do not|don't|dont|no need to|without)(?: include| give| add| provide| write)?(?: any| an)? explanations?(?=\\s*(?:$|[.,;!?]|\\s(?:just|only|and|but|then|also|keep|make|use|write|give|show)\\b))",
        "replace": "no explanation",
        "directive": true
      },
      {
        "pattern": "(?:(?:and|but|also|then|plus)\\s+)?\\b(?:just|only) (?:give me|show me|send me|return|output|respond with|reply with|write) (?:the )?(code|json|answer|result|list|table|summary|command)(?=\\s*(?:$|[.,;!?]|\\s(?:just|only|and|but|then|also|keep|make|use|write|give|show)\\b))",
        "replace": "$1 only",
        "directive": true
      },
      {
        "pattern": "\\b(?:(?:give me|show me|send me)\\s+)?(?:the\\s+)?(?:respond|reply|answer|return|output|result|response)\\s+(?:only\\s+)?(?:in|with|as)\\s+(?:a\\s+|an\\s+)?(json|markdown|yaml|csv|plain text|table)\\b",
        "replace": "output $1"
      },
      {
        "pattern": ",?\\s*(?:ok|okay|right|yeah)\\s*\\?\\s*$",
        "replace": "."
      },
      {
        "pattern": "\\b(?:i|we) (?:will|would) like (?:it|this|that) to\\b",
        "replace": "make it"
      }
    ],
